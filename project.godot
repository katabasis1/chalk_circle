; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Chalk Circle"
config/description="Меловой круг — хоррор-рогалик в одну кнопку"
run/main_scene="res://scenes/main/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.02, 0.012, 0.016, 1)
boot_splash/show_image=false
config/icon="res://icon.svg"

[autoload]

Platform="*res://scripts/autoload/platform.gd"
Save="*res://scripts/autoload/save.gd"
Globals="*res://scripts/autoload/globals.gd"
Audio="*res://scenes/autoload/audio.tscn"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=540
window/size/window_height_override=960
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=6

[gui]

theme/custom="res://assets/ui/theme.tres"

[input]

tap={
